{
  "name": "devbridge-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent": "pnpm --filter @devbridge/local-agent start",
    "demo:api": "pnpm --filter @devbridge/full-stack-demo dev:api",
    "demo:web": "pnpm --filter @devbridge/full-stack-demo dev:web"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
