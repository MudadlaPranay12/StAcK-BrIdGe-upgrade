# Shared secret between Vite Plugin, Local Agent, Backend Tracer, and Extension
DEVBRIDGE_TOKEN=devbridge-local-secret

# Absolute paths to your frontend and backend repositories
FRONTEND_ROOT=./examples/full-stack-demo
BACKEND_ROOT=./examples/full-stack-demo
PORT=4321

# AI provider for Visual Delta & Quick Fixes (server-side default; the panel's
# Enterprise AI Settings can override per request via BYOK).
# provider: gemini | openai | anthropic | openai-compatible (Ollama / gateways)
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=http://127.0.0.1:11434/v1

# Legacy Gemini-only vars (still honored for gemini when AI_API_KEY is unset)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
# DEVBRIDGE_GEMINI_MODEL overrides the default gemini-2.5-flash model.
# DEVBRIDGE_GEMINI_MODEL=
